# ==============================================================================
# Backend environment variables. Copy to `.env` and fill in real values.
# In production (Railway/Render), set these in the service's env var settings —
# never commit a real .env file.
# ==============================================================================

# ── Core ──────────────────────────────────────────────────────────────────────
ENV=development                       # "development" or "production"
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Database ──────────────────────────────────────────────────────────────────
# Leave empty for local SQLite (sql_app.db). In production, set a Postgres URL:
#   postgresql://user:password@host:5432/dbname
DATABASE_URL=

# ── CORS (production only) ────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins. Required in production.
ALLOWED_ORIGINS=https://your-app.vercel.app

# ── Redis / Celery (async jobs) ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── AI provider ───────────────────────────────────────────────────────────────
# Pick one provider; the app auto-detects from whichever key is set.
AI_PROVIDER=groq                      # groq | gemini | openai | anthropic
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Email / SMTP (Gmail app password, NOT your login password) ────────────────
EMAIL_USER=your-address@gmail.com
EMAIL_PASS=your-16-char-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ── Stripe billing ────────────────────────────────────────────────────────────
STRIPE_ENV=test                       # "test" or "live"
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
CHECKOUT_SUCCESS_URL=https://your-app.vercel.app/dashboard/billing?status=success
CHECKOUT_CANCEL_URL=https://your-app.vercel.app/dashboard/billing?status=cancel
# Stripe product/price IDs per tier (create these in your Stripe dashboard)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_TEAMS=price_...

# ── SSO / SAML (optional, for enterprise) ─────────────────────────────────────
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
SAML_METADATA_URL=https://your-tenant.auth0.com/samlp/metadata/xxxxx
SAML_ACS_URL=https://your-backend.com/auth/saml/callback
SAML_ENTITY_ID=https://your-backend.com
AUTH0_OAUTH_CALLBACK_URL=https://your-backend.com/auth/oauth/callback

# ── Code editor sandbox ───────────────────────────────────────────────────────
# Directory user code is read/written/executed within. Defaults to backend/workspaces.
CODE_BASE_DIR=

# ── Observability (optional) ──────────────────────────────────────────────────
SENTRY_DSN=                           # set to enable Sentry error tracking
LOG_LEVEL=INFO
LOG_JSON=false                        # true = structured JSON logs (recommended in prod)
